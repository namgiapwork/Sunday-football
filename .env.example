# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose this to the browser: it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the player PIN session cookie. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Used for absolute links. On Vercel, set this to your deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct Postgres connection, used by the db: scripts only.
# Supabase → Project settings → Database → Connection string → URI
DATABASE_URL=

# Shared secret for the scheduled job. Vercel sends it as a bearer token.
# Generate one with: openssl rand -base64 32
CRON_SECRET=
